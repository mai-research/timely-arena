{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timely-arena",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "ADMIN_DEMO_ENABLED": "true"
  }
}
