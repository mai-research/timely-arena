#!/bin/sh
# Deliberately do not invoke Entire: session data must never be pushed.
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  case "$local_ref:$remote_ref" in
    *refs/heads/entire/*|*refs/entire/*|*refs/codex/*|*refs/stash*)
      echo "Refusing to push private agent/session refs." >&2; exit 1 ;;
  esac
  python3 "$root/scripts/check-public-history.py" "$local_oid" || exit 1
done
